.car-card {
  display: flex;
  gap: 18rpx;
  padding: 18rpx;
  margin-bottom: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e6edf4;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(22, 50, 79, 0.05);
  transition: transform 0.12s ease, background 0.12s ease;
}

.car-card.pressed {
  transform: scale(0.995);
  background: #fbfdff;
}

.cover-wrap {
  position: relative;
  flex: none;
  width: 224rpx;
  height: 168rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #e9eff5, #dce6ef);
}

.cover {
  width: 100%;
  height: 100%;
}

.cover-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #9aabba;
  font-size: 20rpx;
}

.empty-car {
  width: 62rpx;
  height: 34rpx;
  border: 3rpx solid #b9c6d3;
  border-radius: 8rpx;
  position: relative;
}

.empty-car::before {
  content: "";
  position: absolute;
  left: 9rpx;
  right: 9rpx;
  top: -16rpx;
  height: 16rpx;
  border: 3rpx solid #b9c6d3;
  border-bottom: 0;
  border-radius: 10rpx 10rpx 0 0;
}

.badges {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  display: flex;
  gap: 6rpx;
}

.badge {
  padding: 5rpx 9rpx;
  border-radius: 5rpx;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.2;
}

.badge.favorite {
  padding: 3rpx 9rpx 5rpx;
  background: rgba(16, 32, 47, 0.62);
  color: #ffc400;
  font-size: 20rpx;
  text-shadow: 0 0 8rpx rgba(255, 196, 0, 0.45);
}

.badge.new {
  background: rgba(7, 193, 96, 0.92);
}

.badge.consign {
  background: rgba(232, 131, 58, 0.95);
}

.audio-flag {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  padding: 3rpx 8rpx;
  border-radius: 5rpx;
  background: rgba(22, 50, 79, 0.7);
  color: #ffffff;
  font-size: 18rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.title {
  color: #1b2c3c;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.42;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.meta {
  margin-top: 9rpx;
  color: #7b8b9b;
  font-size: 21rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bottom {
  margin-top: auto;
  padding-top: 8rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10rpx;
}

.price {
  color: #e8833a;
  font-weight: 700;
  line-height: 1;
}

.price .num {
  font-size: 34rpx;
}

.price .unit {
  margin-left: 2rpx;
  font-size: 21rpx;
}
