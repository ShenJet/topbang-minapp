<navigator
  class="car-card"
  url="/pages/detail/detail?id={{vehicle.id}}"
  hover-class="pressed"
  hover-stay-time="60"
>
  <view class="cover-wrap">
    <image wx:if="{{vehicle.has_cover}}" class="cover" src="{{vehicle.cover_url}}" mode="aspectFill" lazy-load />
    <view wx:else class="cover-empty">
      <view class="empty-car"></view>
      <text>暂无实拍</text>
    </view>
    <view class="badges">
      <text wx:if="{{vehicle.is_favorite}}" class="badge favorite">★</text>
      <text wx:if="{{vehicle.is_new}}" class="badge new">新上架</text>
      <text wx:if="{{vehicle.is_consignment}}" class="badge consign">寄售</text>
    </view>
    <view wx:if="{{vehicle.audio_brand}}" class="audio-flag">♪ {{vehicle.audio_brand}}</view>
  </view>

  <view class="info">
    <view class="title">{{vehicle.title}}</view>
    <view class="meta">{{vehicle.meta_text}}</view>
    <view class="bottom">
      <view class="price">
        <text class="num">{{vehicle.price_num}}</text>
        <text class="unit">{{vehicle.price_unit}}</text>
      </view>
    </view>
  </view>
</navigator>
