<view class="filter-root">
  <view class="mask {{visible ? 'show' : ''}}" catchtap="onClose" catchtouchmove="noop"></view>

  <view class="sheet {{visible ? 'show' : ''}}" catchtap="noop">
    <view class="sheet-head">
      <view>
        <view class="sheet-title">筛选车源</view>
        <view class="sheet-sub">六个维度，选完点「查看结果」</view>
      </view>
      <view class="sheet-close" catchtap="onClose">×</view>
    </view>

    <scroll-view class="sheet-body" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="group" wx:for="{{groups}}" wx:key="key">
        <view class="group-name">{{item.label}}</view>
        <view class="chips">
          <view
            wx:for="{{item.options}}"
            wx:for-item="opt"
            wx:key="id"
            class="chip {{item.selected === opt.id ? 'on' : ''}}"
            data-group="{{item.key}}"
            data-value="{{opt.id}}"
            catchtap="onPick"
          >{{opt.label}}</view>
        </view>
      </view>
      <view class="sheet-hint">选择「全部」可以清除对应维度；筛选只影响当前车源列表。</view>
    </scroll-view>

    <view class="sheet-foot">
      <view class="btn ghost" catchtap="onReset">重置</view>
      <view class="btn primary" catchtap="onApply">
        <text>查看结果</text>
        <text wx:if="{{activeCount}}" class="btn-count">{{activeCount}}</text>
      </view>
    </view>
  </view>
</view>
