.mask {
  position: fixed;
  inset: 0;
  z-index: 900;
  background: rgba(12, 29, 45, 0.48);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.22s ease, visibility 0.22s ease;
}

.mask.show {
  opacity: 1;
  visibility: visible;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 901;
  display: flex;
  flex-direction: column;
  max-height: 92vh;
  background: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: 0 -20rpx 60rpx rgba(15, 36, 56, 0.18);
  transform: translateY(105%);
  transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.sheet.show {
  transform: translateY(0);
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 30rpx 30rpx 14rpx;
}

.sheet-title {
  color: #16324f;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}

.sheet-sub {
  margin-top: 4rpx;
  color: #93a2b1;
  font-size: 22rpx;
}

.sheet-close {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7b8b9b;
  font-size: 44rpx;
  line-height: 1;
}

.sheet-body {
  height: 56vh;
  padding: 0 30rpx;
}

.group {
  padding: 20rpx 0 22rpx;
  border-bottom: 1rpx solid #edf1f6;
}

.group:last-of-type {
  border-bottom: 0;
}

.group-name {
  color: #223647;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 15rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  padding: 11rpx 22rpx;
  border: 1rpx solid #e2e9f0;
  border-radius: 10rpx;
  background: #f7f9fc;
  color: #536575;
  font-size: 24rpx;
  line-height: 1.3;
}

.chip.on {
  border-color: #e8833a;
  background: #fdf1e7;
  color: #a9551a;
  font-weight: 600;
}

.sheet-hint {
  padding: 8rpx 0 22rpx;
  color: #a0adba;
  font-size: 21rpx;
  line-height: 1.7;
}

.sheet-foot {
  display: flex;
  gap: 18rpx;
  padding: 16rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #edf1f6;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 88rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn.ghost {
  width: 200rpx;
  background: #f2f5f8;
  color: #496071;
}

.btn.primary {
  flex: 1;
  background: linear-gradient(135deg, #e8833a, #f2a15f);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(232, 131, 58, 0.24);
}

.btn-count {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.24);
  font-size: 19rpx;
  line-height: 32rpx;
  text-align: center;
}
