.purchase-page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: #f2f5f8;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 42rpx 34rpx 100rpx;
  background:
    radial-gradient(520rpx 340rpx at 95% 0%, rgba(232, 131, 58, 0.3), transparent 68%),
    radial-gradient(420rpx 300rpx at 0% 12%, rgba(88, 140, 190, 0.26), transparent 70%),
    linear-gradient(160deg, #16324f, #102639);
}

.hero-glow {
  position: absolute;
  right: -150rpx;
  bottom: -180rpx;
  width: 460rpx;
  height: 460rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 50%;
}

.hero-kicker {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  color: #ffd0ad;
  font-size: 21rpx;
  letter-spacing: 1.5rpx;
}

.hero-kicker::before {
  content: "";
  width: 30rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #e8833a;
}

.hero-title {
  position: relative;
  margin-top: 16rpx;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.35;
  letter-spacing: 0.5rpx;
}

.hero-title .accent {
  color: #f2a15f;
}

.hero-sub {
  position: relative;
  margin-top: 12rpx;
  max-width: 600rpx;
  color: #aec0d0;
  font-size: 23rpx;
  line-height: 1.75;
}

.hero-steps {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  padding: 17rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.055);
}

.h-step {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #c5d5e3;
  font-size: 20rpx;
  white-space: nowrap;
}

.h-no {
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(232, 131, 58, 0.22);
  color: #ffd0ad;
  font-size: 17rpx;
  font-weight: 700;
  line-height: 1;
}

.h-line {
  flex: 1;
  height: 1rpx;
  margin: 0 12rpx;
  background: rgba(255, 255, 255, 0.13);
}

.form-card {
  position: relative;
  z-index: 2;
  margin: -60rpx 24rpx 0;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 50rpx rgba(13, 32, 50, 0.11);
}

.form-title {
  margin-bottom: 24rpx;
  padding-left: 18rpx;
  position: relative;
  color: #1b2f40;
  font-size: 32rpx;
  font-weight: 800;
}

.form-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 6rpx;
  border-radius: 3rpx;
  background: #e8833a;
}

.field {
  margin-top: 22rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #354b5d;
  font-size: 24rpx;
  font-weight: 600;
}

.required {
  color: #e8833a;
  font-weight: 700;
}

.field-input,
.picker-inner,
.field-textarea {
  width: 100%;
  border: 1rpx solid #e4ebf2;
  border-radius: 13rpx;
  background: #f7f9fc;
  color: #1f2d3a;
  font-size: 25rpx;
}

.field-input {
  height: 86rpx;
  padding: 0 20rpx;
}

.field-textarea {
  height: 170rpx;
  padding: 16rpx 20rpx;
  line-height: 1.7;
}

.field-ph {
  color: #a7b4c1;
  font-size: 24rpx;
}

.budget-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.budget-box {
  flex: 1;
  min-width: 0;
  height: 86rpx;
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  border: 1rpx solid #e4ebf2;
  border-radius: 13rpx;
  background: #f7f9fc;
}

.budget-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 25rpx;
}

.budget-unit {
  flex: none;
  margin-left: 6rpx;
  color: #93a2b1;
  font-size: 22rpx;
}

.budget-sep {
  flex: none;
  color: #b1bdc8;
  font-size: 24rpx;
}

.picker-inner {
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
}

.picker-text {
  color: #1f2d3a;
  font-size: 25rpx;
}

.picker-ph {
  color: #a7b4c1;
  font-size: 24rpx;
}

.picker-arrow {
  color: #a4b1bd;
  font-size: 22rpx;
}

.submit-btn {
  margin-top: 30rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  background: linear-gradient(135deg, #e8833a, #f2a15f);
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.5rpx;
  box-shadow: 0 14rpx 30rpx rgba(232, 131, 58, 0.26);
}

.submit-btn[disabled] {
  opacity: 0.72;
}

.privacy {
  margin-top: 16rpx;
  color: #9aa8b5;
  font-size: 20rpx;
  line-height: 1.65;
  text-align: center;
}

.section {
  padding: 38rpx 24rpx 0;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 6rpx 18rpx;
}

.section-title {
  color: #16324f;
  font-size: 32rpx;
  font-weight: 800;
}

.section-sub {
  margin-top: 2rpx;
  color: #93a2b1;
  font-size: 21rpx;
}

.request-count {
  flex: none;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #eaf1f8;
  color: #496784;
  font-size: 20rpx;
}

.request-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #e6edf4;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(22, 50, 79, 0.045);
}

.req-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.req-name {
  flex: 1;
  color: #5a6d7d;
  font-size: 21rpx;
  font-weight: 600;
}

.req-time {
  color: #a0adba;
  font-size: 20rpx;
}

.req-status {
  flex: none;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 19rpx;
  line-height: 1.4;
}

.status-new {
  background: #eaf1fe;
  color: #1d4cb3;
}

.status-processing {
  background: #fdf1e7;
  color: #a9551a;
}

.status-done {
  background: #e8f8ef;
  color: #067a3f;
}

.status-closed {
  background: #eff3f7;
  color: #5b6b7a;
}

.req-title {
  margin-top: 10rpx;
  color: #1c3041;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
}

.req-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 13rpx;
}

.req-chip {
  padding: 5rpx 13rpx;
  border-radius: 7rpx;
  background: #f2f5f8;
  color: #5d7183;
  font-size: 20rpx;
  line-height: 1.5;
}

.req-chip.price {
  background: #fdf1e7;
  color: #a9551a;
  font-weight: 600;
}

.req-chip.plain {
  background: transparent;
  border: 1rpx dashed #d8e1e9;
  color: #a0adba;
}

.req-note {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #edf1f6;
  color: #7b8b9b;
  font-size: 22rpx;
  line-height: 1.65;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.list-skeleton {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.sk-req {
  padding: 26rpx 24rpx;
  border: 1rpx solid #e9eff5;
  border-radius: 18rpx;
  background: #ffffff;
}

.sk-line {
  height: 22rpx;
  margin-bottom: 14rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #edf2f7 25%, #f7fafc 37%, #edf2f7 63%);
  background-size: 400% 100%;
  animation: skeleton-shine 1.4s ease infinite;
}

.sk-line:last-child {
  margin-bottom: 0;
}

.sk-line.w40 {
  width: 40%;
}

.sk-line.w55 {
  width: 55%;
}

.sk-line.w75 {
  width: 75%;
}

.list-error {
  padding: 44rpx 24rpx;
  border: 1rpx solid #f2cccc;
  border-radius: 18rpx;
  background: #fdf4f4;
  color: #9e2b2b;
  font-size: 23rpx;
  text-align: center;
}

.retry {
  display: inline-flex;
  margin-top: 16rpx;
  padding: 9rpx 24rpx;
  border: 1rpx solid #e3b5b5;
  border-radius: 999rpx;
  color: #9e2b2b;
  font-size: 21rpx;
}

.list-empty {
  padding: 62rpx 30rpx;
  border: 1rpx solid #e6edf4;
  border-radius: 18rpx;
  background: #ffffff;
  text-align: center;
}

.empty-circle {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f0f4f8;
  color: #9cabb9;
  font-size: 36rpx;
}

.empty-title {
  color: #2b3d4d;
  font-size: 27rpx;
  font-weight: 700;
}

.empty-sub {
  margin-top: 8rpx;
  color: #8b9aa8;
  font-size: 22rpx;
}

.contact-card {
  margin: 30rpx 24rpx 0;
  padding: 26rpx;
  border: 1rpx solid #e7edf4;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f8fbfe, #ffffff);
}

.contact-head {
  margin-bottom: 10rpx;
  padding-left: 16rpx;
  position: relative;
  color: #223647;
  font-size: 26rpx;
  font-weight: 700;
}

.contact-head::before {
  content: "";
  position: absolute;
  left: 0;
  top: 7rpx;
  bottom: 7rpx;
  width: 5rpx;
  border-radius: 3rpx;
  background: #16324f;
}

.contact-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed #e9eff5;
}

.contact-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.contact-label {
  flex: none;
  width: 126rpx;
  color: #93a2b1;
  font-size: 21rpx;
}

.contact-value {
  flex: 1;
  min-width: 0;
  color: #263a4b;
  font-size: 23rpx;
  font-weight: 600;
  word-break: break-all;
}

.contact-copy {
  flex: none;
  padding: 6rpx 18rpx;
  border: 1rpx solid #d9e3ec;
  border-radius: 999rpx;
  color: #496071;
  font-size: 20rpx;
}

.page-foot {
  padding: 46rpx 40rpx 16rpx;
  color: #a5b2bf;
  font-size: 20rpx;
  text-align: center;
  letter-spacing: 0.4rpx;
}
