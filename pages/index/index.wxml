<view class="page">
  <view class="hero">
    <view class="hero-glow"></view>
    <view class="hero-top">
      <view class="brand-block">
        <view class="brand-logo">
          <image class="brand-logo-img" src="/logo-topbang.jpeg" mode="aspectFill" />
        </view>
        <view class="brand-text">
          <view class="store-name">{{store.name || '掏棒的车库'}}</view>
          <view class="store-slogan">{{store.slogan || '苏州 · 二手车精选'}}</view>
        </view>
      </view>
      <view class="hero-badge">精选车源</view>
    </view>

    <view class="hero-stats">
      <view class="stat">
        <view class="stat-num">{{garageTotal || '—'}}</view>
        <view class="stat-label">台在售</view>
      </view>
      <view class="stat-sep"></view>
      <view class="stat">
        <view class="stat-num">{{boards.length}}</view>
        <view class="stat-label">个专区</view>
      </view>
      <view class="stat-sep"></view>
      <view class="stat">
        <view class="stat-num">30天</view>
        <view class="stat-label">求购榜单</view>
      </view>
    </view>

    <view wx:if="{{store.address}}" class="hero-address">
      <view class="pin"></view>
      <text>{{store.address}}</text>
    </view>
  </view>

  <view class="search-shell">
    <view class="search-box">
      <view class="search-icon"></view>
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜索品牌 / 型号 / 牌照，如 奥迪S5"
        placeholder-class="search-ph"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
      />
      <view wx:if="{{keyword}}" class="search-clear" catchtap="onClearKeyword">×</view>
    </view>
  </view>

  <scroll-view class="board-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
    <view class="board-row">
      <view class="board-chip {{boardKey === '' ? 'on' : ''}}" data-key="" bindtap="onBoard">全部</view>
      <view
        wx:for="{{boards}}"
        wx:key="key"
        class="board-chip {{boardKey === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="onBoard"
      >
        <text>{{item.name}}</text>
        <text class="board-num">{{item.count}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="filter-bar">
    <view class="filter-chip {{filters.license_region ? 'on' : ''}}" bindtap="openFilter">
      <text>{{chipLabels.region}}</text>
      <text class="caret">▾</text>
    </view>
    <view class="filter-chip {{filters.price ? 'on' : ''}}" bindtap="openFilter">
      <text>{{chipLabels.price}}</text>
      <text class="caret">▾</text>
    </view>
    <view class="filter-chip {{filters.vehicle_type ? 'on' : ''}}" bindtap="openFilter">
      <text>{{chipLabels.type}}</text>
      <text class="caret">▾</text>
    </view>
    <view class="filter-chip more {{filterCount ? 'on' : ''}}" bindtap="openFilter">
      <text>更多筛选</text>
      <text wx:if="{{filterCount}}" class="filter-count">{{filterCount}}</text>
      <text class="caret">▾</text>
    </view>
  </view>

  <view class="list-head">
    <view class="list-title">{{boardTitle}}</view>
    <view class="list-sub">共 {{total}} 台 · {{sortText}}</view>
  </view>

  <view wx:if="{{loading && !items.length}}" class="skeleton-list">
    <view class="sk-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
      <view class="sk-img"></view>
      <view class="sk-info">
        <view class="sk-line w80"></view>
        <view class="sk-line w55"></view>
        <view class="sk-line w35"></view>
      </view>
    </view>
  </view>

  <view wx:elif="{{!items.length}}" class="empty">
    <view class="empty-circle">∅</view>
    <view class="empty-title">没有找到合适的车源</view>
    <view class="empty-sub">换个关键词或放宽筛选条件，也可以直接发布淘车求购。</view>
    <view class="empty-action" bindtap="goPurchase">去发布求购 →</view>
  </view>

  <view wx:else class="car-list">
    <car-card wx:for="{{items}}" wx:key="id" vehicle="{{item}}" />
  </view>

  <view wx:if="{{items.length}}" class="load-more">
    <block wx:if="{{loadingMore}}">
      <view class="load-spinner"></view>
      <text>正在加载更多…</text>
    </block>
    <block wx:elif="{{hasMore}}">
      <text>上拉加载更多</text>
    </block>
    <block wx:else>
      <text>已经到底啦 · 只推荐真实车源</text>
    </block>
  </view>

  <view class="page-foot">
    <view class="foot-line"></view>
    <view class="foot-text">{{store.name || '掏棒的车库'}} · 一车一况 · 到店可验</view>
  </view>
</view>

<filter-sheet
  visible="{{filterVisible}}"
  value="{{filters}}"
  regions="{{regionOptions}}"
  types="{{typeOptions}}"
  bind:close="onFilterClose"
  bind:apply="onFilterApply"
/>
