.page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 38rpx 30rpx 78rpx;
  background:
    radial-gradient(520rpx 320rpx at 92% -10%, rgba(232, 131, 58, 0.3), transparent 68%),
    radial-gradient(460rpx 300rpx at 0% 10%, rgba(85, 138, 190, 0.28), transparent 70%),
    linear-gradient(160deg, #16324f, #102639);
}

.hero-glow {
  position: absolute;
  right: -140rpx;
  top: -160rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  box-shadow: inset 0 0 80rpx rgba(232, 131, 58, 0.06);
}

.hero-top {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.brand-logo {
  flex: none;
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.24);
  background: #2a0a12;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.32);
}

.brand-logo-img {
  display: block;
  width: 100%;
  height: 100%;
}

.brand-text {
  min-width: 0;
}

.store-name {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.store-slogan {
  margin-top: 2rpx;
  color: #a9bdcf;
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
}

.hero-badge {
  flex: none;
  padding: 7rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  color: #ffd7b8;
  font-size: 20rpx;
  letter-spacing: 0.5rpx;
}

.hero-stats {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 34rpx;
  padding: 20rpx 0;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.055);
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
}

.stat-label {
  margin-top: 2rpx;
  color: #92a9bd;
  font-size: 20rpx;
}

.stat-sep {
  width: 1rpx;
  height: 38rpx;
  background: rgba(255, 255, 255, 0.12);
}

.hero-address {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 20rpx;
  color: #8fa7bc;
  font-size: 21rpx;
}

.pin {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid #e8833a;
  border-radius: 50%;
  box-shadow: 0 0 0 4rpx rgba(232, 131, 58, 0.14);
}

.search-shell {
  position: relative;
  z-index: 4;
  margin: -46rpx 24rpx 0;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 92rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(13, 32, 50, 0.13);
}

.search-icon {
  position: relative;
  flex: none;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #8c9cab;
  border-radius: 50%;
}

.search-icon::after {
  content: "";
  position: absolute;
  right: -10rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #8c9cab;
  transform: rotate(45deg);
  transform-origin: left center;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  color: #1f2d3a;
  font-size: 25rpx;
}

.search-ph {
  color: #a6b3c0;
  font-size: 24rpx;
}

.search-clear {
  flex: none;
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eef3f8;
  color: #8b9aa8;
  font-size: 30rpx;
  line-height: 1;
}

.board-scroll {
  width: 100%;
  margin-top: 28rpx;
  white-space: nowrap;
}

.board-row {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 30rpx;
}

.board-chip {
  flex: none;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 62rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e3eaf1;
  border-radius: 999rpx;
  background: #ffffff;
  color: #536575;
  font-size: 23rpx;
  line-height: 1;
}

.board-chip.on {
  border-color: #16324f;
  background: #16324f;
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(22, 50, 79, 0.18);
}

.board-num {
  min-width: 30rpx;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  background: #eff3f7;
  color: #7b8b9b;
  font-size: 18rpx;
  line-height: 1.4;
  text-align: center;
}

.board-chip.on .board-num {
  background: rgba(255, 255, 255, 0.16);
  color: #ffd7b8;
}

.filter-bar {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  gap: 12rpx;
  padding: 18rpx 24rpx;
  background: rgba(242, 245, 248, 0.97);
  backdrop-filter: blur(10rpx);
}

.filter-chip {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 0 8rpx;
  border: 1rpx solid #e3eaf1;
  border-radius: 10rpx;
  background: #ffffff;
  color: #4d6273;
  font-size: 23rpx;
}

.filter-chip > text:first-child {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.filter-chip.on {
  border-color: #f0c39f;
  background: #fdf1e7;
  color: #a9551a;
  font-weight: 600;
}

.filter-chip.more {
  flex: 1.25;
}

.filter-count {
  flex: none;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 7rpx;
  border-radius: 14rpx;
  background: #e8833a;
  color: #ffffff;
  font-size: 17rpx;
  line-height: 28rpx;
  text-align: center;
}

.caret {
  flex: none;
  color: #a4b1bd;
  font-size: 18rpx;
}

.filter-chip.on .caret {
  color: #c58a5a;
}

.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding: 4rpx 30rpx 18rpx;
}

.list-title {
  color: #16324f;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 0.3rpx;
}

.list-sub {
  color: #93a2b1;
  font-size: 21rpx;
}

.car-list {
  padding: 0 24rpx;
}

.skeleton-list {
  padding: 0 24rpx;
}

.sk-card {
  display: flex;
  gap: 18rpx;
  padding: 18rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid #e9eff5;
  border-radius: 20rpx;
  background: #ffffff;
}

.sk-img {
  flex: none;
  width: 224rpx;
  height: 168rpx;
  border-radius: 14rpx;
  background: linear-gradient(90deg, #edf2f7 25%, #f7fafc 37%, #edf2f7 63%);
  background-size: 400% 100%;
  animation: skeleton-shine 1.4s ease infinite;
}

.sk-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
}

.sk-line {
  height: 24rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #edf2f7 25%, #f7fafc 37%, #edf2f7 63%);
  background-size: 400% 100%;
  animation: skeleton-shine 1.4s ease infinite;
}

.sk-line.w80 {
  width: 80%;
}

.sk-line.w55 {
  width: 55%;
}

.sk-line.w35 {
  width: 35%;
}

.empty {
  margin: 30rpx 24rpx 0;
  padding: 80rpx 40rpx;
  border: 1rpx solid #e6edf4;
  border-radius: 22rpx;
  background: #ffffff;
  text-align: center;
}

.empty-circle {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f0f4f8;
  color: #9cabb9;
  font-size: 40rpx;
}

.empty-title {
  color: #2b3d4d;
  font-size: 29rpx;
  font-weight: 700;
}

.empty-sub {
  margin-top: 10rpx;
  color: #8b9aa8;
  font-size: 23rpx;
  line-height: 1.7;
}

.empty-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 26rpx;
  padding: 16rpx 34rpx;
  border-radius: 999rpx;
  background: #16324f;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 26rpx 20rpx 14rpx;
  color: #9aa8b5;
  font-size: 21rpx;
}

.load-spinner {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #d9e3ec;
  border-top-color: #e8833a;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.page-foot {
  padding: 42rpx 60rpx 20rpx;
  text-align: center;
}

.foot-line {
  width: 52rpx;
  height: 4rpx;
  margin: 0 auto 18rpx;
  border-radius: 2rpx;
  background: #dfe7ef;
}

.foot-text {
  color: #a5b2bf;
  font-size: 20rpx;
  letter-spacing: 0.4rpx;
}
